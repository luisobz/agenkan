{
  "name": "@agenkan/api",
  "version": "1.0.0",
  "private": true,
  "description": "AgenKan API server: notes, kanban board and AI planner over HTTP",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@agenkan/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.9.1",
    "fastify": "^5.3.2",
    "ollama": "^0.5.14",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@agenkan/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
