# ── AgenKan API server ──────────────────────────────────────
# Port the API (and the bundled web app) listens on.
PORT=3210
# Bind address. Use 0.0.0.0 to expose it outside the machine.
HOST=0.0.0.0

# Password required by every client (web and Android) to talk to the API.
# Pick a long random string if you expose the port to the internet.
API_PASSWORD=change-me

# Where the SQLite database file lives.
DATABASE_PATH=./data/agenkan.db

# ── Ollama ──────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
