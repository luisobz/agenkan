{
  "name": "agenkan",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered notepad with a built-in kanban board. Notes become plans, plans become cards.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @agenkan/api dev",
    "dev:web": "pnpm --filter @agenkan/web dev",
    "build": "turbo run build",
    "start": "pnpm --filter @agenkan/api start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "android:sync": "pnpm --filter @agenkan/mobile sync",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@agenkan/config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "baseline-browser-mapping": "2.11.0",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.8",
      "find-my-way": "9.7.0",
      "js-yaml": "4.3.2",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "tar": "7.5.21",
      "tinypool": "2.1.2"
    }
  }
}
