{
  "name": "agenkan",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered notepad with a built-in kanban board. Notes become plans, plans become cards.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @agenkan/api dev",
    "dev:web": "pnpm --filter @agenkan/web dev",
    "build": "turbo run build",
    "start": "pnpm --filter @agenkan/api start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "android:sync": "pnpm --filter @agenkan/mobile sync",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@agenkan/config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  }
}
